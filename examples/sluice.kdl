// Example sluice config. Validate:  sluice --check -c examples/sluice.kdl
// KDL v1 grammar: bare true/false, brace blocks, // comments.

server {
    threads 0                          // 0 = all cores
    metrics-addr "127.0.0.1:9090"      // Prometheus, loopback only
    grace-period-secs 30
    graceful-shutdown-secs 300
    upstream-keepalive-pool 256
    upgrade-sock "/run/sluice/upgrade.sock"
}

client-ip {
    trusted-header "cf-connecting-ip"  // honored only from a trusted proxy peer
    // trusted-proxies default to Cloudflare's ranges; a direct client cannot
    // spoof its IP. Override for a different front (e.g. an internal LB):
    // trusted-proxies "10.0.0.0/8" "192.168.0.0/16"
}

geoip {
    enabled true
    country-header "cf-ipcountry"      // free country from Cloudflare, no DB
    // mmdb-asn  "/etc/sluice/GeoLite2-ASN.mmdb"    // → asn + asn-org in the log
    // mmdb-city "/etc/sluice/GeoLite2-City.mmdb"   // → city in the log
    log-fields "country" "asn" "asn-org"
    metric-labels "country"            // low-cardinality only
}

listener "0.0.0.0:443" {
    http2 true
    tls cert="/etc/sluice/fullchain.pem" key="/etc/sluice/privkey.pem"
}
listener "0.0.0.0:80" {
    redirect-to-https true
}

alias prefix="staging"                 // staging-app.example.com == app.example.com

defaults {
    hsts "max-age=31536000"
    unknown-host 404
}

site "app.example.com" {
    upstream "127.0.0.1:31000"
    websocket true
    deny "^/\.git"                      // 403 these paths (nginx `deny`)
    deny "^/internal/"
}

site "docs.example.com" {              // static file server, no upstream
    file-server {
        root "/var/www/docs"
        index "index.html"
    }
}

site "api.example.com" {
    upstream "127.0.0.1:31100"         // bare host:port = plaintext, client Host preserved
    max-body "32MiB"
    read-timeout-secs 300              // SSE
    rate-limit rps=50 burst=100        // token bucket per client IP
}

site "openai.example.com" {            // reverse-proxy an external HTTPS API
    upstream "https://api.openai.com"  // TLS + SNI; Host rewritten to api.openai.com
    read-timeout-secs 600              // streaming completions can idle between tokens
    // upstream-host "..."             // override the Host sent upstream
    // upstream-verify false           // disable upstream cert verification (testing)
}

site "grafana.example.com" {
    upstream "127.0.0.1:3001"
    websocket true
    access cloudflare-only=true        // 403 unless the peer is a CF edge IP
}

site "example.com" {                   // apex with auth-path redirects
    upstream "127.0.0.1:31000"
    redirect match="^(?:/[a-z]{2})?/(login|register|dashboard)(?:/|$)" target="https://app.example.com{uri}" status=301
    redirect match="^/api/auth(?:/|$)" target="https://app.example.com{uri}" status=301
}
