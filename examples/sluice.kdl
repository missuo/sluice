// Example sluice config. Validate:  sluice --check -c examples/sluice.kdl
// KDL v1 grammar: bare true/false, brace blocks, // comments.
//
// NOTE ON REGEXES: a KDL string treats `\` as an escape, so a regex with a
// backslash must use a KDL *raw string*: match=r"\.php$"  (not "\.php$").

server {
    threads 0                          // 0 = all cores
    metrics-addr "127.0.0.1:9090"      // Prometheus, loopback only
    // Access-log line format: "text" (default, compact human-readable) or "json"
    // (one JSON object per request for structured ingestion — status, latency,
    // bytes, client, host, upstream, protocol, method, geo, bounded error; every
    // field JSON-escaped). Both log the path only, never the query or credentials.
    access-log-format "text"
    grace-period-secs 30
    graceful-shutdown-secs 300
    upstream-keepalive-pool 256
    // Zero-downtime upgrade (`-u`) socket. MUST live in a service-owned 0700
    // directory (systemd `RuntimeDirectory=sluice` gives /run/sluice at 0700);
    // sluice refuses `-u` with the world-writable /tmp default.
    upgrade-sock "/run/sluice/upgrade.sock"

    // --- Privilege separation ---
    // sluice REFUSES to run as root (uid 0) by default. Deploy it under the
    // shipped systemd unit (examples/sluice.service) as a dedicated `sluice`
    // user with AmbientCapabilities=CAP_NET_BIND_SERVICE. Only override if you
    // truly cannot: allow-root true    (or export SLUICE_ALLOW_ROOT=1)
    // When daemonizing, drop to this user/group after binding:
    // user "sluice"
    // group "sluice"

    // --- Slowloris / DoS resilience ---
    // Per-read downstream receive timeout (tightens Pingora's inherited 60s so a
    // stalled body/keepalive read is cut sooner).
    downstream-read-timeout-secs 15
    // Absolute wall-clock deadline for receiving the full request body once
    // headers are complete — a slow body can't reset the per-read timer forever.
    request-timeout-secs 30
    // Per-write downstream response timeout (seconds). Bounds a slow-read (H1) or
    // withheld-WINDOW_UPDATE (H2) client that stalls the response write and would
    // otherwise pin a connection/FD with near-zero bandwidth. Applied to BOTH
    // protocols. Per-write (resets on each successful write), so a steadily-reading
    // client is fine. 0 = disabled (a config warning fires for an unprotected TLS
    // listener). Default 60.
    downstream-write-timeout-secs 60
    // Minimum response send rate (bytes/sec); 0 = off. The stricter ADAPTIVE H1
    // policy (H2 no-op); takes priority over the flat write timeout on H1 when set.
    // min-send-rate-bytes 1024
    // Max IN-FLIGHT connections per client IP, on BOTH the TLS proxy and the :80
    // listener. Enforced pre-handshake (dropped right after TCP accept, bounding a
    // partial-ClientHello flood) AND post-handshake (an exact per-connection guard
    // held for the connection's whole life, freed the instant it closes). 0 = off.
    // LEAVE 0 when fronted by Cloudflare (all peers share CF edge IPs); set it for
    // direct exposure.
    // max-conn-per-ip 100
    // Absolute timeout (seconds) for the downstream TLS handshake, before any HTTP
    // code runs. A partial ClientHello otherwise retains a socket/task for the whole
    // window (pre-HTTP Slowloris on direct exposure). The per-IP connection
    // limiter's pending-slot TTL is derived from this — this window PLUS a fixed
    // scheduling grace — so pre-handshake accounting never expires before the
    // handshake it covers could still be live. Min 1. Default 10.
    tls-handshake-timeout-secs 10
    // Idle-connection timeout (seconds) for a downstream HTTP/2 connection with NO
    // active streams. Stock Pingora waits for the next stream forever, so a client
    // that completes the H2 handshake and then stays silent would pin the
    // socket/FD indefinitely. A long-running active stream keeps the connection
    // open; only a fully idle one is closed. 0 = disabled. Default 60.
    h2-idle-timeout-secs 60
    // Absolute timeout (seconds) for the downstream HTTP/2 connection-preface
    // handshake. Stock Pingora awaits the client's 24-byte preface with no deadline
    // and the idle timeout above only starts AFTER it — so a client that negotiates
    // ALPN h2 over TLS then sends no/partial preface would pin the connection
    // indefinitely. Stays finite even if h2-idle-timeout-secs is 0. Min 1. Default 10.
    h2-handshake-timeout-secs 10
    // Total deadline (seconds) for resolving a HOSTNAME upstream to an address.
    // Upstream DNS runs off the request path (non-blocking); a resolver
    // outage/NXDOMAIN/empty answer returns a bounded 502 instead of panicking the
    // request task or pinning worker threads. IP-literal backends skip DNS. Min 1.
    // Default 5.
    upstream-dns-timeout-secs 5
    // Upstream DNS cache. Within the TTL the resolver is not consulted (no
    // getaddrinfo per request); on expiry the last-known-good answer is served
    // while ONE background refresh runs. Concurrent lookups for the same name
    // coalesce (singleflight), and a global concurrency bound + post-failure
    // backoff keep a DNS flood/outage from spawning unbounded blocking work. A
    // last-known-good answer keeps serving for `stale` seconds past its TTL so a
    // transient resolver outage doesn't drop healthy upstream pools.
    upstream-dns-ttl-secs 30          // fresh TTL; min 1, default 30
    upstream-dns-stale-secs 300       // serve last-known-good this long on failure; 0 = off
    upstream-dns-max-concurrent 8     // global concurrent-resolve cap; min 1
}

client-ip {
    trusted-header "cf-connecting-ip"  // honored only from a trusted proxy peer
    // trusted-proxies default to Cloudflare's ranges; a direct client cannot
    // spoof its IP. Override for a different front (e.g. an internal LB):
    // trusted-proxies "10.0.0.0/8" "192.168.0.0/16"
}

geoip {
    enabled true
    country-header "cf-ipcountry"      // free country from Cloudflare, no DB
    // mmdb-asn  "/etc/sluice/GeoLite2-ASN.mmdb"    // → asn + asn-org in the log
    // mmdb-city "/etc/sluice/GeoLite2-City.mmdb"   // → city in the log
    log-fields "country" "asn" "asn-org"
    metric-labels "country"            // low-cardinality only
}

listener "0.0.0.0:443" {
    http2 true
    tls cert="/etc/sluice/fullchain.pem" key="/etc/sluice/privkey.pem"
    // or dynamic SNI certs:   tls cert-dir="/etc/sluice/certs"
    // or auto-TLS via ACME:   tls acme=true   (needs the `acme {}` block below)
}
listener "0.0.0.0:80" {
    redirect-to-https true              // also answers ACME HTTP-01 challenges
}

// Automatic Let's Encrypt certs (like Caddy) — for a host that resolves DIRECTLY
// to this server with :80 reachable (NOT behind a proxying CDN; behind Cloudflare
// use an Origin CA cert instead). Opt in per site with `acme true`.
// acme {
//     contact "you@example.com"
//     staging false                    // true = Let's Encrypt staging (testing)
//     cache-dir "/var/lib/sluice/acme"
// }

// Response cache backend. Omit for the default in-memory LRU; set this to
// persist cached responses to disk (survives restarts, holds far more than RAM).
// cache-store {
//     dir "/var/cache/sluice"
//     max-size "10GiB"                // reaper evicts oldest over this total size
//     max-files 1000000               // …or over this file count (inode guard)
//     min-free "1GiB"                 // …or when the filesystem drops below this
// }

defaults {
    hsts "max-age=31536000"
    unknown-host 404
}

// A simple single-upstream site (bare `upstream` = an implicit "/" location).
site "app.example.com" {
    upstream "127.0.0.1:31000"
    websocket true
    deny r"^/\.git"                     // 403 these paths (nginx `deny`)
}

// Path routing (nginx `location`) + a load-balanced pool + response cache + WAF.
site "api.example.com" {
    // Site-wide request firewall, checked first.
    waf {
        block field="path" match=r"^/\.\./"          // path traversal
        block field="user-agent" match="(?i)sqlmap|nikto"
        block field="query" match=r"(?i)union\s+select"
    }
    rate-limit rps=50 burst=100          // token bucket per client IP (site-wide)

    // Locations match in order; first match wins (put specific paths first).
    location "/static/" {
        file-server {
            root "/var/www/api-static"
        }
    }
    location "/v1/" {
        // A pool of backends with a balancing policy + connect-failure failover.
        upstream {
            server "10.0.0.1:8080" weight=3   // gets 3× the traffic of the next
            server "10.0.0.2:8080"            // weight defaults to 1
            balance "round-robin"        // round-robin | random | ip-hash | ketama | least-conn
            //   ketama     = consistent hashing by client IP (scaling the pool
            //                only remaps ~1/n of clients; weight scales the share)
            //   least-conn = fewest in-flight requests wins (adapts to load)
            // Active health checks (like Caddy). Omit this block for passive-only
            // (a backend is skipped for 10s after a failed connect). With it, a
            // background task probes each backend and takes it out of rotation
            // proactively — catching a backend that connects but is unhealthy.
            health-check {
                path "/healthz"          // omit → TCP-connect check
                interval-secs 3
                timeout-secs 2
                unhealthy 3              // consecutive fails → down
                healthy 2                // consecutive oks → back up
                // expect-status 200     // default: any 200–399
            }
        }
        read-timeout-secs 300            // SSE / streaming
        max-body "32MiB"
    }
    location "/" {                       // catch-all, cached
        upstream "127.0.0.1:31100"
        cache {
            ttl-secs 60                  // fallback TTL; origin Cache-Control wins
        }
        // Streaming response-body rewrite (nginx sub_filter). Text responses
        // only; the origin is asked for an uncompressed body. Repeatable.
        sub-filter from="http://internal.local" to="https://api.example.com"
    }
}

site "docs.example.com" {              // pure static file server
    file-server {
        root "/var/www/docs"
        index "index.html"
        // Hot-file cache: small files (<= 64 KiB) are held in memory and served
        // for up to this many seconds before a fresh secure re-open revalidates
        // them (bounded staleness). 0 disables the content cache. Default 1.
        // The cache is bounded (entries + total bytes) and scoped to THIS docroot,
        // and every fill/revalidation still uses the fd-pinned, no-symlink open —
        // a symlinked path is refused on the cached path too.
        cache-ttl-secs 1
    }
}

site "openai.example.com" {            // reverse-proxy an external HTTPS API
    upstream "https://api.openai.com"  // TLS + SNI; Host rewritten to api.openai.com
    read-timeout-secs 600              // streaming completions can idle between tokens
    // upstream-host "..."             // override the Host sent upstream
    // upstream-verify false           // disable upstream cert verification (testing)
}

site "grafana.example.com" {
    upstream "127.0.0.1:3001"
    websocket true
    access cloudflare-only=true        // 403 unless the peer is a CF edge IP
}

site "example.com" {                   // apex with auth-path redirects
    upstream "127.0.0.1:31000"
    redirect match=r"^(?:/[a-z]{2})?/(login|register|dashboard)(?:/|$)" target="https://app.example.com{uri}" status=301
    redirect match=r"^/api/auth(?:/|$)" target="https://app.example.com{uri}" status=301
}
